# EveBox Linux release builder based on messense/rust-musl-cross.
#
# MUSL_TARGET selects the target toolchain image: x86_64-musl or
# aarch64-musl. Both images can run on amd64 or arm64 Docker hosts.
ARG MUSL_TARGET=x86_64-musl
FROM docker.io/messense/rust-musl-cross:${MUSL_TARGET}

RUN apt-get update && apt-get -y install \
        git \
        make \
        rpm \
        ruby-dev \
        unzip \
        zip && \
    rm -rf /var/lib/apt/lists/*

# fpm creates the RPM and Debian packages generated by
# packaging/build-dist.sh.
RUN gem install --no-document --bindir=/usr/local/bin fpm -v 1.16.0

# Node.js is used to build the embedded web application. The builder image is
# glibc-based; only the resulting EveBox binary targets musl.
ENV N_V=24.11.1
RUN case "$(uname -m)" in \
        x86_64) N_ARCH=x64 ;; \
        aarch64) N_ARCH=arm64 ;; \
        *) echo "unsupported host architecture" && exit 1 ;; \
    esac && \
    cd /usr/local && \
    curl -o - -L https://nodejs.org/dist/v${N_V}/node-v${N_V}-linux-${N_ARCH}.tar.gz | \
        tar zxf - --strip-components=1

# Install only the static libpcap archive into the musl toolchain sysroot.
# TARGET_HOME/lib and its include directory are already in the target
# compiler's default search paths, so #[link(name = "pcap")] resolves to this
# archive without custom linker flags.
ENV LIBPCAP_V=1.10.5
RUN curl -OL https://www.tcpdump.org/release/libpcap-${LIBPCAP_V}.tar.gz && \
    tar -xzf libpcap-${LIBPCAP_V}.tar.gz && \
    cd libpcap-${LIBPCAP_V} && \
    ./configure --host=${RUST_MUSL_CROSS_TARGET} \
        --prefix=${TARGET_HOME} \
        CC=${TARGET_CC} \
        --disable-shared \
        --without-libnl \
        --disable-dbus \
        --disable-rdma \
        --disable-bluetooth \
        --disable-usb && \
    make -j"$(nproc)" && \
    make install && \
    cd .. && \
    rm -rf libpcap-${LIBPCAP_V} libpcap-${LIBPCAP_V}.tar.gz

# Run builds as the invoking user so bind-mounted artifacts keep useful host
# ownership. Rust and the target compiler remain shared from /root.
ARG REAL_UID=1000
ARG REAL_GID=1000
RUN test "$REAL_GID" != 0 && groupadd --gid ${REAL_GID} builder || true
RUN useradd --non-unique --create-home --uid ${REAL_UID} --gid ${REAL_GID} builder
RUN chmod -R a+rX /root

# The base image's Cargo config selects the target linker. Preserve it when
# moving CARGO_HOME to the unprivileged build user.
RUN mkdir -p /home/builder/.cargo && \
    cp -a /root/.cargo/config* /home/builder/.cargo/ && \
    chown -R builder /home/builder/.cargo

USER builder
ENV RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/home/builder/.cargo \
    PATH=/home/builder/.cargo/bin:/root/.cargo/bin:/usr/local/musl/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
