{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      // tinykeys' package exports don't point at its type declarations.
      "tinykeys": ["./node_modules/tinykeys/dist/tinykeys.d.ts"]
    }
  }
}
